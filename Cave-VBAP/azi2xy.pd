#N canvas 450 240 450 250 10;
#X obj 40 35 inlet;
#X obj 40 70 t f f;
#X obj 40 105 expr -1.7925 * sin($f1 * 3.14159 / 180);
#X obj 240 105 expr 3.183 * cos($f1 * 3.14159 / 180);
#X obj 40 160 outlet;
#X obj 240 160 outlet;
#X text 38 15 Convert azimuth in degrees to VBAP X/Y coordinates.;
#X text 38 195 Ellipse: X radius = 1.7925 m \, Y radius = 3.183 m.;
#X floatatom 194 54 5 0 0 0 - - -;
#X floatatom 101 163 5 0 0 0 - - -;
#X floatatom 188 162 5 0 0 0 - - -;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 1 1 3 0;
#X connect 2 0 4 0;
#X connect 2 0 9 0;
#X connect 3 0 5 0;
#X connect 3 0 10 0;
#X connect 8 0 1 0;
