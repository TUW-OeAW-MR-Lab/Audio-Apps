# This is a Reaper OSC Control file for the MR Lab Audio Server
#
# Piotr Majdak (2026) ÖAW, ISF

# --- Transport Controls ---
PLAY t/play
STOP t/stop
REWIND b/rewind
PAUSE t/pause

# --- Master Volume Fader Position (0.0 to 1.0) ---
TRACK_VOLUME f/track/@/volume/db

# --- Master VU Meters (Actual Audio Levels) ---
# This sends a float representing the signal peak
TRACK_VU n/track/@/vu

# --- Master Timecode ---
TIME f/time